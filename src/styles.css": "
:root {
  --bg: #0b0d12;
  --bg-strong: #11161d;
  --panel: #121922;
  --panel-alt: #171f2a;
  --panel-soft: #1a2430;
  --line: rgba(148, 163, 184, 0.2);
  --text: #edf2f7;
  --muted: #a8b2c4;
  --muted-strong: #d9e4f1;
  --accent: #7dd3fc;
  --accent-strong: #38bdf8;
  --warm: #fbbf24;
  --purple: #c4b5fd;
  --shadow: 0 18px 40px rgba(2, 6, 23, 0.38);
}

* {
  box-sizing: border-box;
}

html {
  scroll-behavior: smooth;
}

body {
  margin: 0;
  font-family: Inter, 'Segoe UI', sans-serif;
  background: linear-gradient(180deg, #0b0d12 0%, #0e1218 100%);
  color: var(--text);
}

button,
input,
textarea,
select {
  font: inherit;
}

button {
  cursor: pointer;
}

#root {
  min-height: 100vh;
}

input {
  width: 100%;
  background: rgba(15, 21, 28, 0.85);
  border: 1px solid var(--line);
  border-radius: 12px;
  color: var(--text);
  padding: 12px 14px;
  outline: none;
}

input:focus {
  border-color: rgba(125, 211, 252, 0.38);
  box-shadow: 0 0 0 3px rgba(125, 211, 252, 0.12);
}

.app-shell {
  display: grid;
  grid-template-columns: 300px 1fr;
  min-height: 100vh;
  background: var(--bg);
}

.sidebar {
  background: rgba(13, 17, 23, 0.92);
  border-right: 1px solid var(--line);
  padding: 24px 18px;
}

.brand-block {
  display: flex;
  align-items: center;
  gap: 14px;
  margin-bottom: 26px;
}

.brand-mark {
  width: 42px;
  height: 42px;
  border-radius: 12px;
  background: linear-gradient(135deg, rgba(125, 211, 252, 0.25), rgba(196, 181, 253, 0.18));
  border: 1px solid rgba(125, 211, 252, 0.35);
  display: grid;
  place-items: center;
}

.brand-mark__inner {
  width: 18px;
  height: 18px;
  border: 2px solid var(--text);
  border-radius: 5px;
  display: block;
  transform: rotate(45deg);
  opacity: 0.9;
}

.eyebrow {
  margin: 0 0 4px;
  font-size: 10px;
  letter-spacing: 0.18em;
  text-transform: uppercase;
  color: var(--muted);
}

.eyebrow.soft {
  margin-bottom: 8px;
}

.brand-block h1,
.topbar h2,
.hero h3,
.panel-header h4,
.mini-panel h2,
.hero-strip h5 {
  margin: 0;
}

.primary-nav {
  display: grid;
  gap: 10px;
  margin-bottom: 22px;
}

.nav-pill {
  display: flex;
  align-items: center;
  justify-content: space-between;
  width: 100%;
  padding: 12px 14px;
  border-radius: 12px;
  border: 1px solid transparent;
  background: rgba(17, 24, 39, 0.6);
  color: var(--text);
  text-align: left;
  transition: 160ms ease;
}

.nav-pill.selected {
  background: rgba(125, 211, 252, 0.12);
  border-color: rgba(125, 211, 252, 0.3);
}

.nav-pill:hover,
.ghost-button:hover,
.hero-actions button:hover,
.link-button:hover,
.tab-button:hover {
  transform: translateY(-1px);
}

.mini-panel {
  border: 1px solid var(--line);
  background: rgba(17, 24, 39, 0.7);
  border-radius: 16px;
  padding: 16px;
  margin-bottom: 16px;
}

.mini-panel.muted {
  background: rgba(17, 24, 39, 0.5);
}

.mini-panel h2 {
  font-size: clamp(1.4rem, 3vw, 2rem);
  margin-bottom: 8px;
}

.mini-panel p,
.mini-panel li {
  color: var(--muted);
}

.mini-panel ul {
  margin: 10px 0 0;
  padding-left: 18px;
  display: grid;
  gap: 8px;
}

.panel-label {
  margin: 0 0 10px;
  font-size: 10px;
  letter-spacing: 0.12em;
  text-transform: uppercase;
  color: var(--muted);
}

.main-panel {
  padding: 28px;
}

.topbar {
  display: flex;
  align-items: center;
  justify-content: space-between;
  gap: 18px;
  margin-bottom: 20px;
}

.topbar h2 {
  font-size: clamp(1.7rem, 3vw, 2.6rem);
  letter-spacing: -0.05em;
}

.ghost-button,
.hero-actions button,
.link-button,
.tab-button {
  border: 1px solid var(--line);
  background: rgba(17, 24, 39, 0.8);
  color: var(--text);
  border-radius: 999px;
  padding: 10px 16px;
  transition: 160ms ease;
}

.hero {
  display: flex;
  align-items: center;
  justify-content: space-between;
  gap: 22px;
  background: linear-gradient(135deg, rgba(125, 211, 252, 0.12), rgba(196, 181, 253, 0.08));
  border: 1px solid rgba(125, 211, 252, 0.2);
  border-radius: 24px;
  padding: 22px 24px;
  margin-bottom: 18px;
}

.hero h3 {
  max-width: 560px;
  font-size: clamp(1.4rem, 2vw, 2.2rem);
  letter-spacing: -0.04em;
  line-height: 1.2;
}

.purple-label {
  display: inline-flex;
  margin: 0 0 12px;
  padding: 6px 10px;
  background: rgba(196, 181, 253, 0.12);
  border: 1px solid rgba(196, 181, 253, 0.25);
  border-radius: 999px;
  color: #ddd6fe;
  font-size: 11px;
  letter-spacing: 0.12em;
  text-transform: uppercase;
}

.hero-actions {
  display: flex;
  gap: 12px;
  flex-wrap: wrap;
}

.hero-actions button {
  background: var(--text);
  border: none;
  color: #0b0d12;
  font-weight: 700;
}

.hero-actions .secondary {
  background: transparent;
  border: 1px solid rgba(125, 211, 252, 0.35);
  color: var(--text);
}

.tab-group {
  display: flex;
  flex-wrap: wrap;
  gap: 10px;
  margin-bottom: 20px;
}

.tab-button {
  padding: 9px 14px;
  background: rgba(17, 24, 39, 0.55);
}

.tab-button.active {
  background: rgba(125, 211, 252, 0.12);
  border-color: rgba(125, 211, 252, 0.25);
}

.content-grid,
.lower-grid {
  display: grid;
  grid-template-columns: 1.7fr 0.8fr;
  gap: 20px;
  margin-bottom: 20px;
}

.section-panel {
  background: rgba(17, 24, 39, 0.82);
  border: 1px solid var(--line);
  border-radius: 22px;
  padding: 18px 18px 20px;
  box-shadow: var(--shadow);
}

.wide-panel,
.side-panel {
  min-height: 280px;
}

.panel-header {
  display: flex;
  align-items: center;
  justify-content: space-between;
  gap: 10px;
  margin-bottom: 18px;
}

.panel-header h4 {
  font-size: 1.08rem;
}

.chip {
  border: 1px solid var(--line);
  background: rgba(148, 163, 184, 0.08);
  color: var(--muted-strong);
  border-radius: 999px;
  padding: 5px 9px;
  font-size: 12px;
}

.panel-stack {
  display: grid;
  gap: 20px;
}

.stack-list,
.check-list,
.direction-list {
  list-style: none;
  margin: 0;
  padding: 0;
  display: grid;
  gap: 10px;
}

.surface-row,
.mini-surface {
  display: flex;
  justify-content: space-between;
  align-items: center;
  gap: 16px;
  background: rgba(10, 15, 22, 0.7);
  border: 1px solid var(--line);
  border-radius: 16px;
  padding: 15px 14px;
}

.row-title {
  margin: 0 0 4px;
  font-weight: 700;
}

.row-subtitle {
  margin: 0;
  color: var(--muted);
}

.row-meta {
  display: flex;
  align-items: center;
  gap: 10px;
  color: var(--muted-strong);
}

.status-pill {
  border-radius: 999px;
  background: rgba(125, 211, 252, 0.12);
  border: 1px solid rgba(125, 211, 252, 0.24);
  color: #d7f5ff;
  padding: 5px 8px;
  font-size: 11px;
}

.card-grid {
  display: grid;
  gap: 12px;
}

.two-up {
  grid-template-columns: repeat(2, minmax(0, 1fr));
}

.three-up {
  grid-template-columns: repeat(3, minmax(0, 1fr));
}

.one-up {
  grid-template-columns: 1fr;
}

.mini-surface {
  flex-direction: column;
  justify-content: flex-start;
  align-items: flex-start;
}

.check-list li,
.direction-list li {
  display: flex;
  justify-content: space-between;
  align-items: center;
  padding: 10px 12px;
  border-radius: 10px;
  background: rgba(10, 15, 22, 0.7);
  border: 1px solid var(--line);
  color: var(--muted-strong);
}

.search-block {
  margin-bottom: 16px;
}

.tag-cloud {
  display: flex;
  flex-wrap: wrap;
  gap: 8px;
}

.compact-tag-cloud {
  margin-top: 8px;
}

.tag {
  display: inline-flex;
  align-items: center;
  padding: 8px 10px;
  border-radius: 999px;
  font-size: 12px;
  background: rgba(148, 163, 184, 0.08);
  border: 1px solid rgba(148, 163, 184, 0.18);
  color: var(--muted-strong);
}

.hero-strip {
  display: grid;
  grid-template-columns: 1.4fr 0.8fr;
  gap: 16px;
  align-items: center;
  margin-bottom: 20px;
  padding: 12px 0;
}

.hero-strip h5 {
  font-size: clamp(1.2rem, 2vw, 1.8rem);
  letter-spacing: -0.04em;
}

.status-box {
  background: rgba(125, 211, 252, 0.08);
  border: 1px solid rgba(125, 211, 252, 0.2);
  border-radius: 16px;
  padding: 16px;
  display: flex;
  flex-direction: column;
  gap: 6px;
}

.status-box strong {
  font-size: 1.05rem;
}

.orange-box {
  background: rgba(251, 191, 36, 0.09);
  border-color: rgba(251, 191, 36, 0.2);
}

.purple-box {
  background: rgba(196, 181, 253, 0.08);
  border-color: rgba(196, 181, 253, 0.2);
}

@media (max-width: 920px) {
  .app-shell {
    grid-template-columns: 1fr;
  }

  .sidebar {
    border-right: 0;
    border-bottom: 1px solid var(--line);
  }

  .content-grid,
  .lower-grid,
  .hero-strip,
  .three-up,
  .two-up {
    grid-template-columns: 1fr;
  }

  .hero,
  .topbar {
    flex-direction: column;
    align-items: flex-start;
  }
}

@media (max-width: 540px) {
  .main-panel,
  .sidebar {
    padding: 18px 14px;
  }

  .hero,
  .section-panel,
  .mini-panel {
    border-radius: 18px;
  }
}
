            ))}
          </ul>
        </div>
      </aside>

      <main className="main-panel">
        <header className="topbar">
          <div>
            <p className="eyebrow soft">Role selector</p>
            <h2>What are you here to do today?</h2>
          </div>
          <button type="button" className="ghost-button">
            Search BEYOND
          </button>
        </header>

        <section className="hero">
          <div>
            <p className="purple-label">{roleConfig[role].title}</p>
            <h3>{roleConfig[role].tagline}</h3>
          </div>
          <div className="hero-actions">
            <button type="button">Create my material</button>
            <button type="button" className="secondary">Use my material</button>
          </div>
        </section>

        <nav className="tab-group" aria-label="Role section navigation">
          {renderRoleTabs()}
        </nav>

        <section className="content-grid">
          <div className="section-panel wide-panel">
            {role === 'Student' && renderStudentView()}
            {role === 'Freedom' && renderFreedomView()}
            {role === 'Open' && renderOpenView()}
          </div>

          <div className="section-panel side-panel">
            <div className="panel-header">
              <h4>Knowledge library</h4>
              <span className="chip">Seed catalogue</span>
            </div>
            <div className="tag-cloud compact-tag-cloud">
              {filteredTopics.slice(0, 10).map((topic) => (
                <span key={topic.id} className="tag">
                  {topic.title}
                </span>
              ))}
            </div>
          </div>
        </section>

        <section className="lower-grid">
          <div className="section-panel">
            <div className="panel-header">
              <h4>Where can I go from here?</h4>
              <span className="chip">Optional</span>
            </div>
            <ul className="direction-list">
              {focusHints.map((item) => (
                <li key={item}>{item}</li>
              ))}
            </ul>
          </div>

          <div className="section-panel">
            <div className="panel-header">
              <h4>Architecture note</h4>
              <span className="chip">Foundation</span>
            </div>
            <ul className="check-list">
              <li>Knowledge library, graph, and AI are designed for later integration</li>
              <li>Data models and app flows are modular and extensible</li>
              <li>Platform shell is ready for future features</li>
            </ul>
          </div>
        </section>
      </main>
    </div>
  );
}

export default App;
